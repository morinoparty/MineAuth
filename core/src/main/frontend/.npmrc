save-exact=true
# Chlorophyll（@morinoparty/chlorophyll-react）は GitHub Packages にある
@morinoparty:registry=https://npm.pkg.github.com
# pnpm はリポジトリ側 .npmrc の認証情報に含まれる環境変数を展開しないため、トークンはここに書かない。
# ユーザー単位の設定（~/.npmrc、CI では setup-node の registry-url）に
# //npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN} を置く
