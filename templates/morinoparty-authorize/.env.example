# Secrets of the production environment used by the deploy authorize page workflow.
# Copy this file to .env, fill in the values, and run:
#   gh secret set -f .env --env production

# URL of the Pelican Panel, such as https://panel.example.com
PELICAN_PANEL_URL=
# Comma-separated server identifiers, such as 1a2b3c4d,5e6f7a8b
PELICAN_SERVER_IDS=
# Client API key of a subuser that can write files on every listed server
PELICAN_CLIENT_API_KEY=
